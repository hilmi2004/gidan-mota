# Brand Configuration
BRAND_NAME=AutoDey
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# MongoDB & Redis (Automatically falls back to embedded local Mongo Replica Set + in-memory Redis if not running)
MONGODB_URI=mongodb://127.0.0.1:27017/autodey?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
USE_LOCAL_EMBEDDED_INFRA=true

# JWT Auth Secrets
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Third-Party Adapter Modes (mock | live)
SMS_PROVIDER=mock
TERMII_API_KEY=
TERMII_SENDER_ID=AutoDey

KYC_PROVIDER=mock
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

CUSTOMS_VERIFICATION_PROVIDER=manual_admin

MEDIA_PROVIDER=mock
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=no-reply@autodey.ng

VIN_PROVIDER=mock
NHTSA_VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles

# Settlement Mode (DIRECT | HOLD)
# NOTE: A legally compliant CBN-licensed escrow partner must be integrated before enabling HOLD publicly.
SETTLEMENT_MODE=DIRECT

